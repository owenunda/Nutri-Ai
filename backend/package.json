{
  "name": "backend",
  "version": "1.0.0",
  "description": "NutriLife es una potente y escalable aplicación de nutrición diseñada para ayudar a los usuarios a gestionar su dieta, realizar un seguimiento de calorías y generar recetas personalizadas de forma inteligente. El núcleo de la aplicación se basa en el concepto de \"nevera virtual\", permitiendo a los usuarios obtener sugerencias de comidas basadas específicamente en los ingredientes que ya tienen a su disposición.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --experimental-test-module-mocks --test \"test/**/*.test.js\"",
    "redis:monitor": "node scripts/redis-cli.js monitor",
    "redis:ping": "node scripts/redis-cli.js ping",
    "redis:keys": "node scripts/redis-cli.js keys",
    "redis:flush": "node scripts/redis-cli.js flush",
    "redis:info": "node scripts/redis-cli.js info",
    "db:apply": "node scripts/db-apply.js",
    "user:set-password": "node scripts/set-password.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^11.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "rate-limiter-flexible": "^11.2.0",
    "redis": "^4.7.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
