NODE_ENV = 'development'

PORT = 3000

HOST_DB = host de la db
PORT_DB = puerto de la db
USER_DB = postgres
PASS_DB = password de la db
NAME_DB = nombre de la db

JWT_SECRET = secret key para jwt

# Client IDs de OAuth de Google (Web, Android, iOS) separados por comas
GOOGLE_CLIENT_IDS = web-id.apps.googleusercontent.com,android-id.apps.googleusercontent.com,ios-id.apps.googleusercontent.com

# Envío de correos con Resend (códigos de verificación y de restablecer contraseña)
RESEND_API_KEY = re_xxxxxxxxxxxxxxxx
EMAIL_FROM = NutriLife <no-reply@mailnutrifile.oween.software>

REDIS_URL = redis://localhost:6379

# Rate limiting (requests/min por usuario/IP)
RATE_LIMIT_CHAT_PER_MINUTE = 10
RATE_LIMIT_AI_WEBHOOK_PER_MINUTE = 60
RATE_LIMIT_AUTH_PER_MINUTE = 5
RATE_LIMIT_GLOBAL_PER_MINUTE = 60