{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "admin-panel",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "admin-panel", "run", "dev"],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "backend", "start"],
      "port": 3000
    },
    {
      "name": "admin-panel-local-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "admin-panel", "run", "dev", "--", "--port", "5174", "--mode", "localapi"],
      "port": 5174
    },
    {
      "name": "landing-page",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "landing-page", "run", "dev", "--", "--port", "5180", "--strictPort"],
      "port": 5180
    }
  ]
}
